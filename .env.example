# Copy this file to a new file named .env (in the same folder) and paste your own key below.
# Never share your .env file or commit it to GitHub. It is already listed in .gitignore.
# Get a key at https://console.anthropic.com  ->  API Keys  ->  Create Key
ANTHROPIC_API_KEY=paste-your-key-here

# Optional: the port the prototype runs on (default 5173)
PORT=5173
